generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentBlockType {
  HEADING
  TEXT
  LIST
  IMAGE
  VIDEO
  VIDEO_EMBED
  FILE
  CALLOUT
  CODE
  QUOTE
  DIVIDER
  EMBED_IFRAME
}

enum EnrollmentRole {
  TEACHER
  STUDENT
}

enum FileAssetStatus {
  PENDING
  UPLOADED
  DELETED
}

enum VideoAssetStatus {
  PENDING
  UPLOADING
  TRANSCODING
  READY
  FAILED
}

enum QuestionType {
  MULTICHOICE
  TRUEFALSE
  SHORTANSWER
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

// ──────────────────────────────────────────────────────────────
// Core models
// ──────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  users         User[]
  courses       Course[]
  questionBanks QuestionBank[]
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  hashedPassword String
  name           String
  role           UserRole
  schoolId       String?  @db.Uuid
  createdAt      DateTime @default(now())

  school             School?           @relation(fields: [schoolId], references: [id])
  courses            Course[]          @relation("CourseCreator")
  enrollments        Enrollment[]
  completions        LessonCompletion[]
  blockViews         BlockView[]
  fileAssets         FileAsset[]
  videoAssets        VideoAsset[]      @relation("VideoAssetUploader")
  questionBanks      QuestionBank[]    @relation("QuestionBankCreator")
  questions          Question[]        @relation("QuestionCreator")
  quizzes            Quiz[]            @relation("QuizCreator")
  quizAttempts       QuizAttempt[]     @relation("QuizAttemptUser")
}

model Course {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String       @db.Uuid
  slug             String
  title            String
  description      String?
  status           CourseStatus @default(DRAFT)
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now())

  // metadata
  subject          String?
  gradeLevel       Int?
  shortDescription String?
  longDescription  Json?
  coverFileAssetId String?      @db.Uuid
  publishedAt      DateTime?

  school           School       @relation(fields: [schoolId], references: [id])
  createdBy        User         @relation("CourseCreator", fields: [createdById], references: [id])
  modules          Module[]
  enrollments      Enrollment[]
  coverFileAsset   FileAsset?   @relation("CourseCover", fields: [coverFileAssetId], references: [id])

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model Module {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String   @db.Uuid
  schoolId  String   @db.Uuid
  title     String
  order     Int
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@index([schoolId])
}

model Lesson {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId  String   @db.Uuid
  schoolId  String   @db.Uuid
  title     String
  order     Int
  createdAt DateTime @default(now())

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks      ContentBlock[]
  completions LessonCompletion[]
  blockViews  BlockView[]

  @@index([moduleId])
  @@index([schoolId])
}

model ContentBlock {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String           @db.Uuid
  schoolId  String           @db.Uuid
  type      ContentBlockType
  data      Json
  order     Int
  createdAt DateTime         @default(now())

  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockViews BlockView[]

  @@index([lessonId])
  @@index([schoolId])
}

model Enrollment {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String         @db.Uuid
  userId    String         @db.Uuid
  role      EnrollmentRole
  createdAt DateTime       @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model LessonCompletion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String   @db.Uuid
  userId      String   @db.Uuid
  schoolId    String   @db.Uuid
  completedAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
  @@index([schoolId])
}

model BlockView {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId        String    @db.Uuid
  lessonId       String    @db.Uuid
  userId         String    @db.Uuid
  schoolId       String    @db.Uuid
  viewedAt       DateTime  @default(now())
  completedAt    DateTime?
  watchedSeconds Int?

  block  ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  lesson Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([blockId, userId])
  @@index([userId])
  @@index([lessonId])
  @@index([schoolId])
}

model FileAsset {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String          @db.Uuid
  uploaderId   String          @db.Uuid
  key          String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  status       FileAssetStatus @default(PENDING)
  createdAt    DateTime        @default(now())

  uploader      User      @relation(fields: [uploaderId], references: [id])
  coursesAsCover Course[] @relation("CourseCover")

  @@index([schoolId])
  @@index([uploaderId])
}

model VideoAsset {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String           @db.Uuid
  uploaderId      String           @db.Uuid
  sourceKey       String           @unique
  hlsMasterKey    String?
  posterKey       String?
  durationSeconds Int?
  width           Int?
  height          Int?
  status          VideoAssetStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime         @default(now())

  uploader User @relation("VideoAssetUploader", fields: [uploaderId], references: [id])

  @@index([schoolId])
  @@index([status])
}

model LearningEvent {
  id         BigInt   @id @default(autoincrement())
  schoolId   String   @db.Uuid
  actorId    String   @db.Uuid
  verb       String
  objectType String
  objectId   String   @db.Uuid
  result     Json?
  context    Json?
  timestamp  DateTime @default(now())

  @@index([schoolId, timestamp(sort: Desc)])
  @@index([actorId, timestamp(sort: Desc)])
  @@index([objectType, objectId])
}

// ──────────────────────────────────────────────────────────────
// Assessment models (quiz engine) — see ADR-004
// ──────────────────────────────────────────────────────────────

model QuestionBank {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  parentId    String?  @db.Uuid
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School         @relation(fields: [schoolId], references: [id])
  createdBy User           @relation("QuestionBankCreator", fields: [createdById], references: [id])
  parent    QuestionBank?  @relation("BankTree", fields: [parentId], references: [id])
  children  QuestionBank[] @relation("BankTree")
  questions Question[]

  @@index([schoolId])
}

model Question {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String       @db.Uuid
  bankId      String       @db.Uuid
  type        QuestionType
  name        String
  data        Json
  version     Int          @default(1)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bank          QuestionBank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("QuestionCreator", fields: [createdById], references: [id])
  quizQuestions QuizQuestion[]

  @@index([schoolId, bankId])
}

model Quiz {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  title            String
  description      String?
  timeLimitSeconds Int?
  maxAttempts      Int?
  passingScore     Float?
  shuffleQuestions Boolean  @default(false)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy     User           @relation("QuizCreator", fields: [createdById], references: [id])
  quizQuestions QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([schoolId])
}

model QuizQuestion {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String @db.Uuid
  quizId     String @db.Uuid
  questionId String @db.Uuid
  order      Int
  points     Float  @default(1)

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([quizId, questionId])
  @@index([quizId, order])
}

model QuizAttempt {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String            @db.Uuid
  quizId            String            @db.Uuid
  userId            String            @db.Uuid
  status            QuizAttemptStatus @default(IN_PROGRESS)
  startedAt         DateTime          @default(now())
  submittedAt       DateTime?
  expiresAt         DateTime?
  score             Float?
  maxScore          Float
  questionsSnapshot Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User           @relation("QuizAttemptUser", fields: [userId], references: [id])
  responses QuizResponse[]

  @@index([schoolId, quizId, userId])
  @@index([status, expiresAt])
}

model QuizResponse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String   @db.Uuid
  attemptId    String   @db.Uuid
  questionId   String   @db.Uuid
  answer       Json
  isCorrect    Boolean?
  earnedPoints Float?
  updatedAt    DateTime @updatedAt

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
