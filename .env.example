# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL (for local dev)
DATABASE_URL=postgresql://parta5:CHANGE_ME@localhost:5432/parta5

# Docker Compose
POSTGRES_PASSWORD=CHANGE_ME

# Least-privilege runtime role used by web/worker (no DDL rights, no BYPASSRLS).
# Migrations still run as the `parta5` owner role — see ADR-002.
POSTGRES_APP_PASSWORD=CHANGE_ME

# MinIO / S3-compatible storage
MINIO_ROOT_USER=parta5admin
MINIO_ROOT_PASSWORD=changeme
S3_BUCKET=parta5-uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<same as MINIO_ROOT_USER for local>
S3_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD for local>
S3_PUBLIC_URL=http://localhost:9000/parta5-uploads
S3_FORCE_PATH_STYLE=true

# Redis (for BullMQ worker)
REDIS_URL=redis://localhost:6379

# How many transcode jobs the worker processes concurrently
WORKER_CONCURRENCY=2

# Kill a stuck ffmpeg job after this many ms (default 30 min) and mark it FAILED
TRANSCODE_TIMEOUT_MS=1800000
