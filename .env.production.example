# ──────────────────────────────────────────────────────────────
# Прод-конфигурация для пилотного инстанса psr.parta5.ru (сервер sel1)
# ──────────────────────────────────────────────────────────────
#
# Используется вместе с docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# Скопируй в `.env` рядом с docker-compose.prod.yml, замени все CHANGE_ME_*
# на реальные значения. НИКОГДА не коммить получившийся `.env` в git —
# он уже в .gitignore, но перепроверь перед коммитом любых изменений.
#
# Список ниже — полный: каждая переменная реально читается кодом или
# нужна docker-compose.prod.yml/Caddyfile для подстановки. См. комментарии
# у каждой, где именно она используется.

# ── Домен и TLS (Caddyfile) ─────────────────────────────────────

# Домен пилота. Должен резолвиться A-записью на IP сервера sel1 (31.184.215.86)
# ДО первого запуска Caddy — иначе выпуск сертификата Let's Encrypt не пройдёт.
SITE_DOMAIN=psr.parta5.ru

# Email для уведомлений Let's Encrypt (истечение сертификата, проблемы с выпуском).
# Реальный адрес, который кто-то читает — не одноразовый.
ACME_EMAIL=CHANGE_ME_admin@parta5.ru

# ── Auth.js v5 (apps/web/auth.ts, apps/web/auth.config.ts) ─────

# Секрет для подписи JWT-сессий. Сгенерировать: openssl rand -base64 32
# При смене секрета все активные сессии инвалидируются (пользователей разлогинит).
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# Публичный URL инстанса. Auth.js v5 использует его для построения callback-адресов
# и для сверки Origin/Host при проверке CSRF. ОБЯЗАН побайтово совпадать со схемой
# и доменом, на который реально ходят пользователи (https://, без слэша на конце) —
# иначе логин молча отваливается (см. раздел «Грабли» в docs/deployment/sel1-psr.md).
AUTH_URL=https://psr.parta5.ru

# AUTH_TRUST_HOST зашит как true прямо в docker-compose.prod.yml (не переменная) —
# приложение стоит за Caddy (reverse proxy), это обязательно для доверия
# X-Forwarded-* заголовкам. Здесь не задаётся, упомянуто для полноты картины.

# ── PostgreSQL (db, миграция 20260716000000_grant_app_role, ADR-002) ─────

# Пароль роли-владельца схемы `parta5`. Использует ТОЛЬКО сервис `migrate`
# (prisma migrate deploy — нужны права DDL). Роль/БД создаются образом postgres
# автоматически при первом старте волюма pgdata.
POSTGRES_PASSWORD=CHANGE_ME_strong_password_1

# Пароль роли `parta5_app` — под ней реально работают web и worker в рантайме
# (SELECT/INSERT/UPDATE/DELETE, без DDL, без BYPASSRLS). Роль создаётся скриптом
# docker/postgres-init/01-app-role.sh при первой инициализации кластера,
# права выданы миграцией 20260716000000_grant_app_role.
POSTGRES_APP_PASSWORD=CHANGE_ME_strong_password_2

# ── MinIO / S3-совместимое хранилище (packages/storage/src/index.ts) ─────

# Логин/пароль root-пользователя MinIO. MINIO_ROOT_PASSWORD должен быть
# не короче 8 символов — иначе MinIO откажется стартовать.
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password_3

# Бакет для файлов этого инстанса (картинки вопросов, обложки курсов, видео).
# Создаётся автоматически сервисом minio-init при первом запуске.
S3_BUCKET=parta5-psr

# Регион для AWS SDK — MinIO физически его игнорирует, но клиент требует
# непустое значение. Менять не нужно.
S3_REGION=us-east-1

# ВНУТРЕННИЙ адрес MinIO в docker-сети. MinIO НЕ публикуется на хост (порты 9000/9001
# не проброшены — см. docker-compose.prod.yml) и не должен быть доступен снаружи:
# основная раздача файлов (картинки/PDF вопросов, обложки) идёт через авторизованный
# прокси-эндпоинт приложения /api/files/[id] (ADR-005), которому достаточно этого
# внутреннего адреса.
S3_ENDPOINT=http://minio:9000

# ВНИМАНИЕ (см. подробности в docs/deployment/sel1-psr.md, раздел «Грабли»):
# этот URL также используется для HLS-видео (packages/video/src/self-hosted.ts,
# storage.publicUrl()) — там ссылки на плейлист/постер отдаются браузеру НАПРЯМУЮ,
# а не через /api/files/[id]. При внутреннем адресе (как здесь) браузер пользователя
# не сможет их получить — видео (self-hosted HLS) на этом инстансе работать не будет,
# пока это не решено отдельно (проксирующий роут или публикация /public/* через Caddy).
# Для пилота ПСР (тесты с картинками, без self-hosted видео) это не блокер, но если
# видео понадобится — не удивляйся 404 на плейлист, это известное ограничение, не баг.
S3_PUBLIC_URL=http://minio:9000/parta5-psr

# Обязательно true для MinIO (path-style, а не virtual-hosted-style адресация бакетов).
S3_FORCE_PATH_STYLE=true

# ── Redis / BullMQ (apps/worker/src/index.ts, apps/web server routers) ─────
#
# REDIS_URL зашит в docker-compose.prod.yml как redis://redis:6379 (без пароля,
# доступ только из внутренней docker-сети — порт наружу не публикуется).
# Переменная здесь не нужна, упомянута для полноты списка.

# ── Worker (apps/worker/src/index.ts, apps/worker/src/jobs/transcode-video.ts) ─────

# Сколько job'ов (импорт .mbz, транскодинг видео) воркер обрабатывает параллельно.
# FFmpeg прожорлив по памяти — см. mem_limit воркера в docker-compose.prod.yml.
# На сервере с 4 vCPU/8GB безопасный дефолт — 2. Поднимать вместе с mem_limit.
WORKER_CONCURRENCY=2

# Через сколько мс зависший ffmpeg-джоб считается упавшим и помечается FAILED.
# 1800000 = 30 минут — достаточно даже для длинных лекций в 1080p.
TRANSCODE_TIMEOUT_MS=1800000
